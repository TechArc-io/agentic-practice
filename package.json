{
  "name": "agentic-practice",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-on assignments for the Astudylab Agentic Engineering course, built on tally, a shared-expense ledger.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pr-contract": "node scripts/check-pr-contract.ts",
    "check:assignment": "node scripts/check-assignment.ts",
    "check:verified": "node scripts/check-verified.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:verified"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
